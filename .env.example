# HTTP bind config
PORT=8880
# AML_BIND_ADDR=0.0.0.0:8880

# Three-server dummy integration
WALLET_PORT=8891
ALIPAY_PORT=8892
PAYPAY_PORT=8893
ALIPAY_BASE_URL=http://localhost:8892
PAYPAY_BASE_URL=http://localhost:8893

# Set Membership algorithm for three-server demo.
# explicit = current shuffle-based sigma proof
# implicit = vector-commitment-like Merkle PoC baseline
# hybrid   = bucketed subset + explicit sigma proof baseline
AML_MEMBERSHIP_MODE=explicit
AML_MEMBERSHIP_WARN_TIMEOUT_MS=1000
AML_MEMBERSHIP_HARD_TIMEOUT_MS=30000

# SQLite audit trail
AML_AUDIT_DB_URL=sqlite:data/aml_audit.sqlite

# Optional staging hardening.
# Leave empty/commented for local demo without API key.
# AML_API_KEY=zkp-demo-123
# AML_RATE_LIMIT_PER_MINUTE=60
# AML_CORS_ORIGINS=http://localhost:8880
